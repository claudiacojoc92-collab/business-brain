node_modules/
dist/
*.env
.env.*
!.env.example
coverage/
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
logs/

# Secrets / keys (defensive — none should ever be committed)
*.pem
*.key
*.p12
*.keystore

# Editor / OS cruft
.idea/
.vscode/
*.swp
Thumbs.db

# Claude Code local tool state (not project source); team config is shared
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/hooks/

# macOS/cloud-sync duplicate artifacts ("foo 2.ts"). Enumerated by extension (NOT a broad
# "* 2.*") so a legitimately-named "step 2.md" is never silently swallowed.
* 2.ts
* 2.tsx
* 2.js
* 2.mjs
* 2.cjs
* 2.json
* 2.md
* 2.sql

# Redis local dump artifact
dump.rdb

# PII / local-only (added for safety)
database/seeds/*prod*.sql
docker-compose.override.yml

# Local git worktrees kept inside the repo
.worktrees/

# Claude Code per-user settings (explicit, so it stays ignored even if the blanket
# `.claude/` rule above is narrowed to let a shared .claude/settings.json be tracked)
.claude/settings.local*.json
