# Keep host build artefacts out of the image context so the image installs/builds
# its own (correct-arch) deps and dist. node_modules especially must NOT leak in
# (host bcrypt is built for the host OS/arch).
node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo
.git
.env
.env.*
*.log
coverage
**/coverage

# macOS/cloud-sync duplicate artifacts ("foo 2.ts") — keep them out of the build context so
# they never compile into the image as dead duplicates. Enumerated (root + nested), not broad.
* 2.ts
**/* 2.ts
* 2.tsx
**/* 2.tsx
* 2.js
**/* 2.js
* 2.mjs
**/* 2.mjs
* 2.cjs
**/* 2.cjs
* 2.json
**/* 2.json
* 2.md
**/* 2.md
* 2.sql
**/* 2.sql

# Unwired/local-only files kept in the working tree but never part of any deployed image.
# meta-dev.routes.ts is dead code (not registered in routes/index.ts) yet `COPY apps` + `tsc -b`
# would otherwise compile it into the api image; the two web files are unreferenced by the Vite
# build. Excluding them from the build context guarantees they cannot ride into an image.
apps/api/src/routes/meta-dev.routes.ts
apps/web/bb-review.html
apps/web/src/businessbrain/review-entry.tsx
