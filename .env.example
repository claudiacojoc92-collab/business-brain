# Business Brain — Environment Variables
# Copy to .env and fill in real values before running locally.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bbuser:bbpassword@localhost:5432/businessbrain
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=businessbrain
DATABASE_USER=bbuser
DATABASE_PASSWORD=bbpassword

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ─── Workers ─────────────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=3001
SCHEDULER=true

# ─── Auth (RS256) ────────────────────────────────────────────────────────────
# RS256 PEM keys, \n-escaped onto a single line (env_file-safe; the app reconstitutes
# the newlines at ingestion). Generate a dev keypair, then escape each to one line:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   awk 'BEGIN{ORS="\\n"}1' private.pem   # → JWT_PRIVATE_KEY value (do the same for public.pem)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_BASE64_PKCS8_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----\n
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_BASE64_SPKI_PUBLIC_KEY_BODY\n-----END PUBLIC KEY-----\n

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_REAL_KEY

# ─── LLM Model Selection ─────────────────────────────────────────────────────
LLM_STRONG_MODEL=claude-sonnet-4-6
LLM_MEDIUM_MODEL=claude-haiku-4-5

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_WITH_REAL_KEY

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte (64 hex chars) AES-256-GCM field encryption key
# Generate: openssl rand -hex 32
KMS_KEY_ID=REPLACE_WITH_64_CHAR_HEX_KEY

# ─── Telemetry ───────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=bb-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info

# ─── Secrets Manager (production) ────────────────────────────────────────────
# AWS_REGION=eu-west-1
# AWS_SECRET_NAME=businessbrain/production

# ─── Encryption (REQUIRED) ───────────────────────────────────────────────────
# 32-byte (64 hex chars) AES-256-GCM field-encryption key for OAuth credentials
# (Google + Meta share it — provider-agnostic, ADR-009). Generate: openssl rand -hex 32
# DO NOT delete this line when editing .env — losing it orphans every stored credential.
# Durable backup kept at ~/.config/business-brain/google_oauth_encryption_key
GOOGLE_OAUTH_ENCRYPTION_KEY=

# ─── App origin (where the SPA lives) ────────────────────────────────────────
# The OAuth callbacks redirect the browser back here after connecting. Local dev = the
# Vite origin; production = the deployed web origin.
APP_ORIGIN=http://localhost:5173

# ─── TWO SEPARATE META APPS / TWO APP IDs (intentional — DO NOT unify or "fix") ──
# Business Brain integrates two DISTINCT Meta products, each with its OWN app id + secret:
#   • Facebook Login for Business       → META_CLIENT_ID   = 1497368125469672  ("Business Brain Social Conn")
#   • Instagram API w/ Instagram Login  → INSTAGRAM_APP_ID = 1119839884555345  (Instagram Business Login app)
# These two app IDs are DIFFERENT BY DESIGN. Do NOT set INSTAGRAM_APP_ID to the Facebook
# app id — the Instagram Business Login flow requires its own Instagram app id, and the
# Facebook Login flow requires the Facebook app id. Confirmed correct 2026-07-23.
#
# ─── Meta / Facebook Login for Business ──────────────────────────────────────
# App Dashboard → Facebook Login for Business. Enables pages_show_list,
# pages_read_engagement, instagram_basic (linked-IG discovery). CONFIG_ID is optional
# (Login for Business permission configuration). Register the redirect URI below in the
# App Dashboard EXACTLY (production: https://YOUR_DOMAIN/api/sources/meta/callback).
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/sources/meta/callback
META_CONFIG_ID=

# ─── Instagram API with Instagram Login ──────────────────────────────────────
# App Dashboard → Instagram → API setup with Instagram Login. Enables
# instagram_business_basic + instagram_business_manage_insights. Register the redirect
# URI below EXACTLY (production: https://YOUR_DOMAIN/api/sources/instagram/callback).
# NOTE: this is the INSTAGRAM app id (Instagram Business Login) — production 1119839884555345.
# It is intentionally DIFFERENT from META_CLIENT_ID (the Facebook app, 1497368125469672).
# Do not change it to match the Facebook app id.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/sources/instagram/callback
