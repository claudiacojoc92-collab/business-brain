# Business Brain web — nginx static serving + same-origin API proxy.
# FE uses API_BASE='/' (relative), so /v1, /auth and /api are proxied to the api service
# (mirrors apps/web/vite.config.ts dev proxy). Everything else is the SPA.
#
# This is an nginx TEMPLATE: the nginx image entrypoint (20-envsubst-on-templates.sh) renders
# ${PORT} from the environment into /etc/nginx/conf.d/default.conf at container start, so the
# server binds Railway's injected $PORT. Only ${PORT} is substituted; nginx's own $host,
# $remote_addr, $scheme, etc. are lowercase and are left untouched by envsubst.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # --- API (same-origin) → the api service over Railway private networking ---
  # Static upstream: nginx resolves api.railway.internal once at startup via the system resolver
  # (no Docker embedded-DNS resolver needed). The api listens on 0.0.0.0:3000; Railway private
  # networking reaches it over IPv4/IPv6. Trade-off: a startup-resolved host is cached until the
  # next reload, so a web redeploy/restart is needed if the api's private IP changes.
  location /v1/ {
    proxy_pass http://api.railway.internal:3000;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /auth/ {
    proxy_pass http://api.railway.internal:3000;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Social sources (Meta App Review): /api/sources/* — connect/read/disconnect enforce JWT INSIDE
  # the api handlers; the OAuth callbacks under this prefix are intentionally auth-free (identity
  # rides the OAuth `state`). nginx only forwards the full path; it neither adds nor requires auth.
  location /api/ {
    proxy_pass http://api.railway.internal:3000;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # --- Static build assets: Vite fingerprints every file (…-<hash>.js/.css), so the content can
  #     never change under a given name. Cache them hard. ---
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # --- SPA fallback: client routes (/login, /onboarding, /dashboard, /review, /business-brain, /).
  #     index.html MUST NOT be cached, or the browser keeps running an old bundle that references
  #     stale (deleted) asset hashes after a deploy. no-cache forces a revalidate every load, so a
  #     fresh deploy is picked up immediately — no hard refresh required. ---
  location / {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    add_header Pragma "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
