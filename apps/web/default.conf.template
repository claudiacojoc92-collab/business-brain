# Business Brain web — nginx static serving + same-origin API proxy.
# FE uses API_BASE='/' (relative), so /v1, /auth and /api are proxied to the api service
# (mirrors apps/web/vite.config.ts dev proxy). Everything else is the SPA.
#
# This is an nginx TEMPLATE: the nginx image entrypoint (20-envsubst-on-templates.sh) renders
# ${PORT} from the environment into /etc/nginx/conf.d/default.conf at container start, so the
# server binds Railway's injected $PORT. Only ${PORT} is substituted; nginx's own $host,
# $request_uri, $api_upstream, etc. are lowercase and are left untouched by envsubst.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # --- API (same-origin) → api service on the compose network ---
  # `resolver` + variable defers DNS to request time, so nginx starts even if api is down.
  location /v1/ {
    resolver 127.0.0.11 valid=10s;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream$request_uri;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /auth/ {
    resolver 127.0.0.11 valid=10s;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream$request_uri;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Social sources (Meta App Review): /api/sources/* — connect/read/disconnect enforce JWT INSIDE
  # the api handlers; the OAuth callbacks under this prefix are intentionally auth-free (identity
  # rides the OAuth `state`). nginx only forwards the full path; it neither adds nor requires auth.
  location /api/ {
    resolver 127.0.0.11 valid=10s;
    set $api_upstream http://api:3000;
    proxy_pass $api_upstream$request_uri;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # --- SPA fallback: client routes (/login, /onboarding, /dashboard, /review, /) ---
  location / {
    try_files $uri $uri/ /index.html;
  }
}
