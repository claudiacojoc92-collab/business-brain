{
  "name": "business-brain",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "type-check": "tsc --build",
