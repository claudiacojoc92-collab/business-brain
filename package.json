    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@deepgram/sdk": "^3.9.0",
    "@expo-google-fonts/inter": "^0.2.3",
    "@fontsource/inter": "^5.0.18",
    "@napi-rs/canvas": "^0.1.65",
    "@resvg/resvg-js": "^2.6.2",
    "opentype.js": "^1.3.4"
